# ===== Pluggy (dashboard.pluggy.ai > Applications) =====
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_CLIENT_USER_ID=cfo-central
# 200 = MeuPluggy (gratuito p/ uso pessoal). "*" mostra todos os conectores no widget.
PLUGGY_CONNECTOR_IDS=200
PLUGGY_INCLUDE_SANDBOX=false
# Itens extras (vírgula) — opcional
PLUGGY_ITEM_IDS=

# ===== Segurança =====
# chave longa e aleatória para assinar a sessão (INICIAR.bat gera uma)
SECRET_KEY=
SESSION_HOURS=12
# senha do Postgres local (docker-compose usa)
POSTGRES_PASSWORD=

# ===== Rotinas =====
PLUGGY_SYNC_HOURS=4
MARKET_SYNC_HOUR=19
TX_WINDOW_DAYS=90

# ===== Regras =====
REVIEW_MIN_AMOUNT=50
REVIEW_MIN_CONFIDENCE=0.6
FGC_LIMIT=250000
# nomes do titular para detectar transferência própria (além do nome vindo do banco), separados por vírgula
OWNER_NAMES=

# ===== Alertas por e-mail (opcional) =====
# Gmail: crie uma "senha de app" em myaccount.google.com/apppasswords (exige verificação em 2 etapas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# destino (vazio = o próprio SMTP_USER)
ALERT_EMAIL_TO=
ALERTS_HOUR=8

# ===== Webhooks (opcional): URL pública apontando para este app =====
PUBLIC_URL=

# Sem Docker (INICIAR-SEM-DOCKER.bat usa SQLite). Com Docker, o compose define DATABASE_URL.
# DATABASE_URL=sqlite:///data/cfo-central.db
